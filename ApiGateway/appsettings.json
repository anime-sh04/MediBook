{
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/auth" },
          { "PathPrefix": "/api/v1/auth" }
        ]
      },
      "providerRoute": {
        "ClusterId": "providerCluster",
        "Match": { "Path": "/providers/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/providers" },
          { "PathPrefix": "/api/v1/providers" }
        ]
      },
      "scheduleRoute": {
        "ClusterId": "scheduleCluster",
        "Match": { "Path": "/schedule/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/schedule" },
          { "PathPrefix": "/api/v1/schedule" }
        ]
      },
      "appointmentRoute": {
        "ClusterId": "appointmentCluster",
        "Match": { "Path": "/appointments/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/appointments" },
          { "PathPrefix": "/api/v1/appointments" }
        ]
      },
      "paymentRoute": {
        "ClusterId": "paymentCluster",
        "Match": { "Path": "/payment/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/payment" },
          { "PathPrefix": "/api/v1/payment" }
        ]
      },
      "notificationRoute": {
        "ClusterId": "notificationCluster",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/notifications" },
          { "PathPrefix": "/api/v1/notifications" }
        ]
      },
      "reviewRoute": {
        "ClusterId": "reviewCluster",
        "Match": { "Path": "/reviews/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/reviews" },
          { "PathPrefix": "/api/v1/reviews" }
        ]
      }
    },

    "Clusters": {
      "authCluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5000/" }
        }
      },
      "providerCluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5001/" }
        }
      },
      "scheduleCluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5002/" }
        }
      },
      "appointmentCluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5003/" }
        }
      },
      "paymentCluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5005/" }
        }
      },
      "notificationCluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5006/" }
        }
      },
      "reviewCluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5007/" }
        }
      }
    }
  }
}